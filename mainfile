// 8. KANBAN APPLICATION TRACKER VIEW
// ==========================================
function ApplicationTrackerView({ applications, setApplications, showToast }) {
  const STAGES = ["Applied", "Assessment", "Interview", "Offer"];

  const handleAdvanceStatus = (id) => {
    const updated = applications.map(app => {
      if (app.id === id) {
        const currentIdx = STAGES.indexOf(app.status);
        const nextStatus = STAGES[(currentIdx + 1) % STAGES.length];
        return { ...app, status: nextStatus };
      }
      return app;
    });
    setApplications(updated);
    showToast("Application stage updated!");
  };

  return (
    <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
      
      <div className="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h1 className="text-3xl font-extrabold text-white">Application Tracker</h1>
          <p className="text-xs text-slate-400">Manage placement drives, hackathon leads, and off-campus applications</p>
        </div>
        <button 
          onClick={() => showToast("New application entry added!")}
          className="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition flex items-center gap-1.5"
        >
          <Plus className="w-4 h-4" />
          <span>Add Application</span>
        </button>
      </div>

      {/* Kanban Columns */}
      <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
        {STAGES.map((stage) => {
          const stageApps = applications.filter(a => a.status === stage);
          return (
            <div key={stage} className="bg-slate-900/60 border border-slate-800 rounded-2xl p-4 space-y-4 min-h-[500px]">
              
              <div className="flex items-center justify-between pb-2 border-b border-slate-800">
                <span className="text-xs font-bold uppercase tracking-wider text-slate-300">{stage}</span>
                <span className="text-xs font-bold px-2 py-0.5 rounded bg-slate-800 text-slate-300">{stageApps.length}</span>
              </div>

              <div className="space-y-3">
                {stageApps.map((app) => (
                  <div key={app.id} className="bg-slate-950 p-4 rounded-xl border border-slate-800 hover:border-slate-700 transition space-y-3">
                    <div className="flex justify-between items-start">
                      <div>
                        <h4 className="font-bold text-white text-xs">{app.company}</h4>
                        <div className="text-[11px] text-slate-400">{app.role}</div>
                      </div>
                      <span className="text-[10px] font-mono text-emerald-400 font-bold bg-emerald-500/10 px-1.5 py-0.5 rounded">
                        ATS {app.atsScore}
                      </span>
                    </div>

                    <div className="text-[10px] text-slate-500 space-y-1">
                      <div>Applied: {app.date}</div>
                      <div className="text-indigo-400 font-medium">• {app.nextAction}</div>
                    </div>

                    <button 
                      onClick={() => handleAdvanceStatus(app.id)}
                      className="w-full py-1.5 rounded bg-slate-900 hover:bg-slate-800 text-[10px] font-bold text-slate-300 transition"
                    >
                      Advance Stage →
                    </button>
                  </div>
                ))}
              </div>

            </div>
          );
        })}
      </div>

    </div>
  );
}

