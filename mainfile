// ==========================================
function InterviewPrepStudio({ showToast }) {
  const [selectedRole, setSelectedRole] = useState('swe');
  const [currentQuestionIdx, setCurrentQuestionIdx] = useState(0);
  const [userAnswerText, setUserAnswerText] = useState('');
  const [isEvaluating, setIsEvaluating] = useState(false);
  const [evaluationResult, setEvaluationResult] = useState(null);

  const QUESTIONS = {
    swe: [
      "Tell me about a complex project you built using React or Python and how you handled performance bottlenecks.",
      "Explain the difference between SQL indexing and full table scans to a junior engineer.",
      "Describe a time when you had a disagreement with a team member during a hackathon."
    ],
    pm: [
      "How would you improve the food delivery funnel for Swiggy during heavy rain hours in Bengaluru?",
      "Walk me through your framework for prioritizing features on a college app."
    ]
  };

  const activeQuestions = QUESTIONS[selectedRole] || QUESTIONS.swe;

  const handleEvaluateAnswer = () => {
    if (!userAnswerText.trim()) {
      showToast("Please type or record an answer before submitting.");
      return;
    }
    setIsEvaluating(true);
    setTimeout(() => {
      setEvaluationResult({
        score: "8.4 / 10",
        clarity: "8.5",
        relevance: "9.0",
        impact: "7.8",
        structure: "8.2",
        feedback: "Great structural response using STAR method. To improve further, quantify your internship impact metrics (e.g. mention percentages or team sizes)."
      });
      setIsEvaluating(false);
    }, 1200);
  };

  return (
    <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
      
      <div className="text-center space-y-2 max-w-2xl mx-auto">
        <h1 className="text-3xl font-extrabold text-white">Prepare Like You're Already Hired</h1>
        <p className="text-xs text-slate-400">Interactive AI Mock Interview Studio with automated response grading</p>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        {/* Question Selector Controls (4 cols) */}
        <div className="lg:col-span-4 space-y-4">
          <div className="bg-slate-900 border border-slate-800 p-5 rounded-2xl space-y-4">
            <h3 className="text-xs font-bold uppercase tracking-wider text-slate-300">Target Role Domain</h3>
            <div className="grid grid-cols-2 gap-2 text-xs font-semibold">
              <button 
                onClick={() => { setSelectedRole('swe'); setCurrentQuestionIdx(0); setEvaluationResult(null); }}
                className={`p-2.5 rounded-xl border text-center transition ${selectedRole === 'swe' ? 'bg-indigo-600 border-indigo-500 text-white' : 'bg-slate-950 border-slate-800 text-slate-400'}`}
              >
                Software Engineer
              </button>
              <button 
                onClick={() => { setSelectedRole('pm'); setCurrentQuestionIdx(0); setEvaluationResult(null); }}
                className={`p-2.5 rounded-xl border text-center transition ${selectedRole === 'pm' ? 'bg-indigo-600 border-indigo-500 text-white' : 'bg-slate-950 border-slate-800 text-slate-400'}`}
              >
                Product Manager
              </button>
            </div>

            <div className="space-y-2 pt-2 border-t border-slate-800">
              <h4 className="text-[11px] font-bold text-slate-400 uppercase">Question Bank</h4>
              {activeQuestions.map((q, idx) => (
                <button
                  key={idx}
                  onClick={() => { setCurrentQuestionIdx(idx); setEvaluationResult(null); setUserAnswerText(''); }}
                  className={`w-full text-left p-3 rounded-xl text-xs border transition ${currentQuestionIdx === idx ? 'bg-slate-950 border-indigo-500 text-indigo-300' : 'bg-slate-950/40 border-slate-800/80 text-slate-400 hover:text-slate-200'}`}
                >
                  Q{idx + 1}: {q.substring(0, 50)}...
                </button>
              ))}
            </div>
          </div>
        </div>

        {/* Practice Room Interactive Canvas (8 cols) */}
        <div className="lg:col-span-8 bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-6">
          
          <div className="bg-slate-950 p-5 rounded-xl border border-slate-800 space-y-2">
            <div className="flex items-center justify-between text-xs text-indigo-400 font-bold">
              <span>AI INTERVIEWER QUESTION #{currentQuestionIdx + 1}</span>
              <span className="text-[10px] px-2 py-0.5 rounded bg-indigo-500/10 border border-indigo-500/20">TECHNICAL / BEHAVIORAL</span>
            </div>
            <p className="text-sm font-semibold text-white leading-relaxed">
              "{activeQuestions[currentQuestionIdx]}"
            </p>
          </div>

          {/* User Answer Input */}
          <div className="space-y-2">
            <div className="flex items-center justify-between">
              <label className="text-xs font-bold text-slate-300 uppercase">Your Spoken or Typed Response</label>
              <button 
                onClick={() => showToast("Microphone active! Listening to spoken answer...")}
                className="text-xs text-rose-400 font-bold hover:underline flex items-center gap-1"
              >
                <Mic className="w-3.5 h-3.5" /> Speak Answer
              </button>
            </div>
            <textarea 
              value={userAnswerText}
              onChange={(e) => setUserAnswerText(e.target.value)}
              placeholder="Type your answer here using STAR framework (Situation, Task, Action, Result)... E.g., In my frontend internship at TechNova, I noticed slow dashboard rendering..."
              className="w-full h-40 bg-slate-950 border border-slate-800 rounded-xl p-4 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition resize-none font-mono"
            ></textarea>
          </div>

          <button 
            onClick={handleEvaluateAnswer}
            disabled={isEvaluating}
            className="w-full py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs uppercase tracking-wider shadow-lg transition flex items-center justify-center gap-2"
          >
            {isEvaluating ? <RefreshCw className="w-4 h-4 animate-spin text-amber-300" /> : <Sparkles className="w-4 h-4 text-amber-300" />}
            <span>Grade My Answer with AI</span>
          </button>

          {/* AI Feedback Grade Result */}
          {evaluationResult && (
            <div className="bg-slate-950 border border-slate-800 p-6 rounded-xl space-y-4 animate-fadeIn">
              <div className="flex items-center justify-between border-b border-slate-800 pb-3">
                <span className="text-xs font-bold text-slate-300">AI FEEDBACK & METRICS</span>
                <span className="text-lg font-black text-emerald-400">Score: {evaluationResult.score}</span>
              </div>

              <div className="grid grid-cols-4 gap-2 text-center text-xs">
                <div className="bg-slate-900 p-2 rounded border border-slate-800">
                  <div className="text-slate-400 text-[10px]">Clarity</div>
                  <div className="font-bold text-indigo-400">{evaluationResult.clarity}</div>
                </div>
                <div className="bg-slate-900 p-2 rounded border border-slate-800">
                  <div className="text-slate-400 text-[10px]">Relevance</div>
                  <div className="font-bold text-sky-400">{evaluationResult.relevance}</div>
                </div>
                <div className="bg-slate-900 p-2 rounded border border-slate-800">
                  <div className="text-slate-400 text-[10px]">Impact</div>
                  <div className="font-bold text-amber-400">{evaluationResult.impact}</div>
                </div>
                <div className="bg-slate-900 p-2 rounded border border-slate-800">
                  <div className="text-slate-400 text-[10px]">Structure</div>
                  <div className="font-bold text-emerald-400">{evaluationResult.structure}</div>
                </div>
              </div>

              <p className="text-xs text-slate-300 leading-relaxed bg-slate-900/60 p-3 rounded-lg border border-slate-800/80">
                <span className="text-amber-400 font-bold">Suggestions: </span>
                {evaluationResult.feedback}
              </p>
            </div>
          )}

        </div>

      </div>

    </div>
  );
}

